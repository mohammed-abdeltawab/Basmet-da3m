# الحماية العامة لجميع صفحات الموقع الأساسي
/*
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  
  # سياسة أمان المحتوى للموقع العام (تسمح بـ Supabase للـ Forms والـ CDNs للخطوط والأيقونات)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: https://*.supabase.co blob:; frame-ancestors 'none';

# منع كاش صفحة البروفايل لتحديث بيانات العضو فوراً في حال تسجيل الدخول
/user-profile.html
  Cache-Control: no-cache, no-store, must-revalidate

# كاش قوي ممتد للملفات الثابتة لرفع سكور الـ PageSpeed والأداء
/img/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable